{
	"version": 2,
	"name": "bxr-test",
	"builds": [
		{
			"src": "server.js",
			"use": "@vercel/node",
			"config": {
				"includeFiles": [
					"index.html",
					"assets/**",
					"game-catalog.js",
					"enhanced-ui.js",
					"enhanced-ui.css"
				]
			}
		}
	],
	"routes": [
		{ "src": "/api/(.*)", "dest": "server.js" },
		{ "src": "/(.*)", "dest": "server.js" }
	]
}
